{
  "_info": "Complete Shotput preset with all configurable properties",
  "bl_version": "1.1.1",
  "core_passes": ["Beauty", "Diffuse", "Specular", "Reflection"],
  "aovs": ["AO", "Shadow", "Fresnel", "Roughness"],
  "data_passes": [
    "z",
    "mist",
    "normal",
    "vector",
    "position",
    "occlusion",
    "crypto_object",
    "crypto_material",
    "crypto_asset"
  ],
  "render_layer": "MyRenderLayer",
  "variant": "MAIN",
  "core_override": "BEAUTY",
  "aov_override": "UTILITY",
  "root_folder_token": "{workdir}/{subpath}/{renderlayer}_{passname}_{variant}/{version}",
  "file_name_token": "{renderlayer}_{passname}_{variant}",
  "default_file_format": "PNG",
  "file_format_overrides": {
    "core": "UI",
    "aov": "UI",
    "data": "OPEN_EXR_MULTILAYER"
